{
  "name": "rentshield",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter rentshield-server dev",
    "dev:client": "pnpm --filter rentshield-client dev",
    "build": "pnpm prisma:generate && pnpm --filter rentshield-server build && pnpm --filter rentshield-client build",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "@prisma/client",
      "@prisma/engines",
      "core-js",
      "esbuild",
      "prisma",
      "protobufjs"
    ]
  }
}
